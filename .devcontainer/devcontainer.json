{
  "name": "XGIC Payload CMS Dev Containers",
  // Producer exemplar: Docker Compose attach (not standalone image:).
  // Consumer contract: docs/architecture.md + AGENTS.md + README.
  // No initializeCommand / postAttach / postStart / postCreate hooks.
  // Git DX runs once from Docker Compose primary service command.
  "dockerComposeFile": "./docker-compose.yml",
  "service": "xgic-payload-cms-dev",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
  ],
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  // Lifecycle: prefer explicit XGIC CLI. First run inside the container:
  //   xgic payload setup    # env + DB (dbAdapter) + scaffold under app/
  //   xgic payload dev
  // Git DX (Compose start only): chown ssh-home + configure-git-dx.sh --quiet
  // Prefer HTTPS + VS Code host credential helper. Never copy host private keys.
  // Overrides: XGIC_GIT_PREFER_HTTPS, XGIC_DOCKER_HOST_OS
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "christian-kohler.npm-intellisense",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GraphQL.vscode-graphql",
        "ms-azuretools.vscode-docker",
        "ms-vscode.vscode-typescript-next",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "streetsidesoftware.code-spell-checker",
        "usernamehw.errorlens"
      ]
    }
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Payload CMS"
    }
  }
}
