{
  "name": "XGIC Payload CMS Dev Containers",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "xgic-payload-cms-dev",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
  ],
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  // === LIFECYCLE HOOKS ===
  // initializeCommand runs on the host before the container is created.
  // It is intentionally kept minimal and silent when possible.
  "initializeCommand": "bash .devcontainer/scripts/init-env.sh",

  // postStartCommand runs every time the container starts.
  // Because setup-payload.sh is idempotent and produces no output when
  // the project already exists, this is the best place for it.
  "postStartCommand": "bash .devcontainer/scripts/setup-payload.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "christian-kohler.npm-intellisense",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GraphQL.vscode-graphql",
        "ms-azuretools.vscode-docker",
        "ms-vscode.vscode-typescript-next",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "streetsidesoftware.code-spell-checker",
        "usernamehw.errorlens"
      ]
    }
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Payload CMS"
    }
  }
}